{
  "manifest_version": 3,
  "name": "Follow Studio",
  "version": "4.2.4",
  "description": "Instagram JSON ZIP arşivini yerel olarak karşılaştır, hesapları koru ve takip listeni düzenle.",
  "permissions": ["storage", "alarms", "cookies", "power"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Follow Studio"},
  "content_scripts": [{
    "matches": ["https://www.instagram.com/*"],
    "js": ["i18n.js", "bridge.js", "follow-content.js", "relationships-content.js", "dm-content.js", "content.js"],
    "run_at": "document_end",
    "all_frames": true
  }]
}
